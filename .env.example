# Supabase Configuration
# Replace with your own Supabase project credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: fixed back URL for Mercado Pago subscriptions (must be HTTPS)
# If not set, the official site URL will be used
SITE_URL=https://dividepass.com
VITE_SITE_URL=https://dividepass.com
VITE_MERCADO_PAGO_BACK_URL=https://dividepass.com/dashboard

# Push notifications (Supabase edge functions)
# WEB_PUSH_PUBLIC_KEY is used in the browser; the private key stays only in Supabase secrets
WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:support@dividepass.com
